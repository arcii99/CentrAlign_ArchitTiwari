# Nova runs on a free local model by default (Ollama). No paid API is needed.
# Point these at any OpenAI-compatible endpoint instead if you have one.
NOVA_LLM_PROVIDER=ollama
NOVA_LLM_MODEL=qwen3.5:4b
# NOVA_LLM_BASE_URL=http://127.0.0.1:11434
# NOVA_LLM_API_KEY=
# 20k is the most that keeps qwen3.5:4b fully on a 6 GB GPU (24k+ spills to the CPU)
# NOVA_LLM_NUM_CTX=20480
# NOVA_LLM_KEEP_ALIVE=30m
# NOVA_LLM_OPTIONS={"presence_penalty": 0}

# Where Nova finds the company (defaults match the local mock world)
# NOVA_DRIVE=var/world/drive
# NOVA_VAULT=var/world/secrets.json
# NOVA_RUNS_DIR=var/runs
# NOVA_TODAY=05-10-2026
